{
  "info": {
    "_postman_id": "b7c1e5a2-4f3d-4a9b-9c21-8f0d5e6a7b31",
    "name": "SIM-KDO REST API",
    "description": "Koleksi REST API SIM-KDO (Laravel 13 + Sanctum).\n\nCara pakai:\n1. Jalankan `php artisan serve` (default http://127.0.0.1:8000).\n2. Pastikan `php artisan migrate --seed` sudah dijalankan.\n3. Buka request **Auth > Login**, tekan Send. Token otomatis disimpan ke variabel koleksi `{{token}}`.\n4. Semua request lain otomatis memakai header `Authorization: Bearer {{token}}`.\n\nAkun demo: `admin@sim-kdo.test` / `password` (role admin) dan `operator@sim-kdo.test` / `password` (role operator).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "kendaraan_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pegawai_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "perangkat_daerah_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Token tersedia', function () {",
                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Token tersimpan ke variabel koleksi.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sim-kdo.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login dan dapatkan Bearer token. Gunakan `operator@sim-kdo.test` / `password` untuk menguji pembatasan data per perangkat daerah."
          }
        },
        {
          "name": "Profil Saya (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Menampilkan user yang sedang login beserta perangkat daerahnya."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Menghapus token yang sedang dipakai. Setelah logout, token tidak bisa dipakai lagi (mendapat 401)."
          }
        }
      ]
    },
    {
